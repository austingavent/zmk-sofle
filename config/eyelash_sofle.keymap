#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 3 2>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <2>;
    trigger-period-ms = <9>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    custom_tapprefer: custom_tapprefer {
        compatible = "zmk,behavior-hold-tap";
        label = "CUSTOM_TAPPREFER";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <175>;
        flavor = "tap-preferred";
    };

    behaviors {
        mmv_slow: mmv_slow {
            compatible = "zmk,behavior-mouse-move";
            #binding-cells = <1>;
            delay-ms = <0>;
            time-to-max-speed-ms = <500>;
            acceleration-exponent = <1>;
        };

        mmv_fast: mmv_fast {
            compatible = "zmk,behavior-mouse-move";
            #binding-cells = <1>;
            delay-ms = <0>;
            time-to-max-speed-ms = <100>;
            acceleration-exponent = <2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        superwhisper: superwhisper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp LEFT_CONTROL>;
            label = "SUPERWHISPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC                                     &kp N1     &kp N2        &kp N3              &kp N4     &kp N5                    &kp UP_ARROW     &kp N6                              &kp N7     &kp N8              &kp N9                 &kp N0                               &mt COLON MINUS
&custom_tapprefer LA(LG(LEFT_CONTROL)) TAB  &kp Q      &kp W         &kp E               &kp R      &kp T                     &kp DOWN_ARROW   &kp Y                               &kp U      &kp I               &kp O                  &kp P                                &kp EQUAL
&mt LEFT_SHIFT CAPS                         &kp A      &kp S         &kp D               &kp F      &kp G                     &kp LEFT_ARROW   &kp H                               &kp J      &kp K               &kp L                  &kp SEMI                             &kp APOS
&mo 3                                       &kp Z      &kp X         &kp C               &kp V      &kp B                     &kp RIGHT_ARROW  &kp N                               &kp M      &kp COMMA           &kp DOT                &mt BACKSLASH FSLH                   &kp ENTER
&kp C_MUTE                                  &kp LCTRL  &kp LEFT_ALT  &mt LEFT_GUI ENTER  &lt 1 F13  &mt LEFT_ALT BACKSPACE    &kp ENTER        &custom_tapprefer LEFT_SHIFT SPACE  &lt 3 RET  &lt 2 LC(LEFT_ALT)  &mt LEFT_BRACKET LPAR  &mt RIGHT_BRACKET RIGHT_PARENTHESIS
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3             &kp F4           &kp F5             &mmv MOVE_UP     &kp F6              &kp F7        &kp F8         &kp F9             &kp F10        &kp F11
&trans      &mkp LCLK        &mmv MOVE_UP    &mkp RCLK          &mkp MB3         &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP           &kp END       &kp UP         &kp HOME           &kp MINUS      &kp EQUAL
&trans      &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &mmv MOVE_RIGHT  &trans             &mmv MOVE_LEFT   &kp LG(LEFT_ARROW)  &kp LEFT      &kp DOWN       &kp RIGHT          &kp LG(RIGHT)  &kp RIGHT_BRACKET
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF    &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &kp LS(LA(LEFT))    &kp LA(LEFT)  &kp LA(RIGHT)  &kp LS(LA(RIGHT))  &kp F12        &trans
&kp C_MUTE  &trans           &trans          &kp LA(BACKSPACE)  &trans           &kp BACKSPACE      &mkp LCLK        &mkp LCLK           &mkp RCLK     &mkp MCLK      &trans             &trans
            >;

            display-name = "layer1";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6         &kp F7        &kp F8          &kp F9            &kp F10            &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mmv MOVE_DOWN   &trans         &trans        &kp F11         &kp F12           &kp UNDER          &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &mmv MOVE_LEFT   &trans         &trans        &trans          &trans            &kp LBRC           &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &kp PLUS       &kp EQUAL     &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp COMMA          &trans
&trans     &trans        &trans          &trans        &trans        &trans          &mkp LCLK        &kp LA(MINUS)  &kp LA(PLUS)  &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;

            display-name = "layer2";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&kp TILDE  &trans  &trans  &trans  &trans  &trans    &kp LA(L)          &trans  &trans         &trans         &trans     &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans    &kp LA(K)          &trans  &trans         &trans         &trans     &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans    &kp LA(J)          &trans  &kp LA(MINUS)  &kp LA(PLUS)   &trans     &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans    &kp LA(SEMICOLON)  &trans  &trans         &trans         &trans     &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans    &kp LS(LA(SQT))    &trans  &trans         &kp PAGE_DOWN  &kp PG_UP  &trans
            >;

            display-name = "layer3";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer4";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
